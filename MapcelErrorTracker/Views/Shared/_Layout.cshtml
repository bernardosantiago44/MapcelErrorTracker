@inject MapcelErrorTracker.Services.CssProvider CssProvider
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Error Logger</title>
    <style>@Html.Raw(CssProvider.Css)</style>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<script src="https://unpkg.com/lucide@0.525.0/dist/umd/lucide.min.js"></script>
<script>
    window.renderLucide = function (root) {
        if (!window.lucide) return;

        if (root) {
            lucide.createIcons({
                root,
                attrs: {
                    'stroke-width': 1.75
                }
            });
            return;
        }

        lucide.createIcons({
            attrs: {
                'stroke-width': 1.75
            }
        });
    };

    document.addEventListener('DOMContentLoaded', function () {
        window.renderLucide();
    });
</script>

<body class="bg-gray-50 min-h-screen">
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>