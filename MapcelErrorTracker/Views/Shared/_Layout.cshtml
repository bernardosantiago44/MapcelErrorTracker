@inject MapcelErrorTracker.Services.CssProvider CssProvider
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Error Logger</title>
    <style>@Html.Raw(CssProvider.Css)</style>
</head>
<body class="bg-gray-50 min-h-screen">
@RenderBody()
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>