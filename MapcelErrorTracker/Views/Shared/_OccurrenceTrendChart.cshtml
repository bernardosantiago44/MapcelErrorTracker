@using System.Globalization
@using MapcelErrorTracker.Services
@model OccurrenceTrendChartViewModel

<section class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden"
         x-data="{ open: true }"
         data-occurrence-trend
         data-error-id="@Model.ErrorId"
         data-summary-url="@Url.Content($"~/errors/{Model.ErrorId}/occurrences/summary")"
         data-histogram-url="@Url.Content($"~/errors/{Model.ErrorId}/occurrences/histogram")"
         data-initial-first-seen="@Model.FirstSeen.ToString("O", CultureInfo.InvariantCulture)"
         data-initial-last-seen="@Model.LastSeen.ToString("O", CultureInfo.InvariantCulture)"
         data-max-buckets="@IErrorOccurrenceMetricService.MaxHistogramBuckets">
    <button type="button"
            @@click="open = !open"
            class="w-full px-5 py-4 flex items-center justify-between border-b border-gray-100 hover:bg-gray-50 transition-colors text-left">
        <h2 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
            <i data-lucide="chart-line" style="width:16px;height:16px" class="text-teal-600"></i>
            Tendencia de ocurrencias
            <span class="text-xs font-normal text-gray-400" data-occurrence-trend-bucket-label></span>
        </h2>
        <i data-lucide="chevron-down" style="width:16px;height:16px" class="text-gray-400 transition-transform" x-bind:class="open ? 'rotate-180' : ''"></i>
    </button>

    <div x-show="open" x-transition class="p-5 space-y-4">
        <div class="occurrence-toolbar flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
            <div class="occurrence-range-group flex flex-wrap gap-1.5" role="group" aria-label="Rango de tiempo">
                <button type="button" data-range="24h" class="occurrence-range rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-500 hover:border-teal-300 hover:text-teal-700 transition-colors">Últimas 24h</button>
                <button type="button" data-range="7d" class="occurrence-range rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-500 hover:border-teal-300 hover:text-teal-700 transition-colors">Últimos 7d</button>
                <button type="button" data-range="30d" class="occurrence-range rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-500 hover:border-teal-300 hover:text-teal-700 transition-colors">Últimos 30d</button>
                <button type="button" data-range="historical" class="occurrence-range rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-500 hover:border-teal-300 hover:text-teal-700 transition-colors">Histórico</button>
                <button type="button" data-range="custom" class="occurrence-range rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-500 hover:border-teal-300 hover:text-teal-700 transition-colors">Personalizado</button>
            </div>

            <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
                <label class="font-semibold text-gray-500" for="occurrence-bucket-@Model.ErrorId">Bucket</label>
                <select id="occurrence-bucket-@Model.ErrorId" data-bucket-select class="rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 focus:outline-none focus:ring-2 focus:ring-teal-400">
                    <option value="auto" selected>Auto</option>
                    <option value="minute">Minuto</option>
                    <option value="hour">Hora</option>
                    <option value="day">Día</option>
                    <option value="week">Semana</option>
                </select>
                <span class="text-gray-300">|</span>
                <span class="font-semibold text-gray-500">Tipo</span>
                <span class="inline-flex rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-1.5 font-semibold text-gray-700">Línea</span>
            </div>
        </div>

        <div class="hidden grid-cols-1 gap-3 rounded-lg border border-gray-100 bg-gray-50 p-3 sm:grid-cols-2" data-custom-range>
            <label class="text-xs font-semibold text-gray-500">
                Inicio
                <input type="datetime-local" data-custom-from class="mt-1 w-full rounded-lg border border-gray-200 bg-white px-2.5 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-teal-400"/>
            </label>
            <label class="text-xs font-semibold text-gray-500">
                Fin
                <input type="datetime-local" data-custom-to class="mt-1 w-full rounded-lg border border-gray-200 bg-white px-2.5 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-teal-400"/>
            </label>
        </div>

        <div class="occurrence-chart-frame rounded-lg border border-gray-100 bg-gray-50 p-3">
            <div class="occurrence-chart-shell relative h-72 min-h-72">
                <canvas class="occurrence-chart-canvas" data-occurrence-chart aria-label="Tendencia de ocurrencias" role="img"></canvas>
                <div class="absolute inset-0 hidden items-center justify-center rounded-lg bg-gray-50/90 text-sm font-medium text-gray-500" data-chart-state></div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-3 border-t border-gray-100 pt-4 text-sm sm:grid-cols-2 xl:grid-cols-3">
            <div>
                <p class="text-xs text-gray-400">Primera vez</p>
                <p class="font-semibold text-gray-800" data-stat-first-seen>...</p>
            </div>
            <div>
                <p class="text-xs text-gray-400">Última vez</p>
                <p class="font-semibold text-gray-800" data-stat-last-seen>...</p>
            </div>
            <div>
                <p class="text-xs text-gray-400">Total ocurrencias</p>
                <p class="font-semibold text-gray-800" data-stat-total>...</p>
            </div>
            <div>
                <p class="text-xs text-gray-400">Pico del rango</p>
                <p class="font-semibold text-gray-800" data-stat-peak>...</p>
            </div>
            <div>
                <p class="text-xs text-gray-400">Bucket actual</p>
                <p class="font-semibold text-gray-800" data-stat-current>...</p>
            </div>
            <div>
                <p class="text-xs text-gray-400">Heat score</p>
                <p class="font-semibold text-gray-800" data-stat-heat>...</p>
            </div>
        </div>
    </div>
</section>
