@model MapcelErrorTracker.Models.ErrorItem
@using MapcelErrorTracker.Models
@{
    ViewData["Title"] = Model.Code;
}

@functions {
    static string PriorityBadge(ErrorPriority p) => p switch
    {
        ErrorPriority.Alta => "bg-red-100 text-red-700 border border-red-300",
        ErrorPriority.Media => "bg-amber-100 text-amber-700 border border-amber-300",
        _ => "bg-gray-100 text-gray-600 border border-gray-300"
    };

    static string StatusBadge(ErrorStatus s) => s switch
    {
        ErrorStatus.New => "bg-green-50 text-green-700 border border-green-300",
        ErrorStatus.InReview => "bg-blue-50 text-blue-700 border border-blue-300",
        ErrorStatus.Postponed => "bg-amber-50 text-amber-700 border border-amber-300",
        ErrorStatus.Resolved => "bg-gray-50 text-gray-500 border border-gray-300",
        _ => "bg-gray-100 text-gray-600 border border-gray-300"
    };

    static string StatusLabel(ErrorStatus s) => s switch
    {
        ErrorStatus.New => "Nuevo",
        ErrorStatus.InReview => "En Revisión",
        ErrorStatus.Postponed => "Pospuesto",
        ErrorStatus.Resolved => "Resuelto",
        _ => s.ToString()
    };

    static string FormatDate(DateTime dt) =>
        dt.ToString("d MMM, yyyy · HH:mm");
}

<div class="max-w-4xl mx-auto px-6 py-8">

    <!-- Back link + Header -->
    <div class="mb-6">
        <a asp-controller="Errors" asp-action="Index"
           class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-800 mb-4">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Regresar
        </a>
        <div class="flex items-start justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold font-mono text-gray-900">@Model.Code</h1>
            </div>
            <div class="flex gap-2 flex-shrink-0">
                <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold @PriorityBadge(Model.Priority)">@Model.Priority</span>
                <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold @StatusBadge(Model.Status)">@StatusLabel(Model.Status)</span>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white border border-gray-200 rounded-xl p-4 mb-6 shadow-sm flex flex-wrap gap-4 items-center">
        <div class="flex items-center gap-2">
            <label class="text-sm font-medium text-gray-600">Estatus:</label>
            <form asp-action="UpdateStatus" method="post" class="inline flex items-center gap-2">
                <input type="hidden" name="id" value="@Model.Id"/>
                <select name="status" class="text-sm border border-gray-200 rounded-lg px-3 py-1.5 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-400">
                    @foreach (var s in Enum.GetValues<ErrorStatus>())
                    {
                        <option value="@s" selected="@(Model.Status == s ? "selected" : null)">@StatusLabel(s)</option>
                    }
                </select>
                <button type="submit" class="bg-emerald-600 text-white text-sm px-3 py-1.5 rounded-lg hover:bg-emerald-700 transition-colors">
                    Actualizar
                </button>
            </form>
        </div>
        <div class="flex items-center gap-2">
            <label class="text-sm font-medium text-gray-600">Prioridad:</label>
            <form asp-action="UpdatePriority" method="post" class="inline flex items-center gap-2">
                <input type="hidden" name="id" value="@Model.Id"/>
                <select name="priority" class="text-sm border border-gray-200 rounded-lg px-3 py-1.5 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-400">
                    @foreach (var p in Enum.GetValues<ErrorPriority>())
                    {
                        <option value="@p" selected="@(Model.Priority == p ? "selected" : null)">@p</option>
                    }
                </select>
                <button type="submit" class="bg-gray-700 text-white text-sm px-3 py-1.5 rounded-lg hover:bg-gray-800 transition-colors">
                    Actualizar
                </button>
            </form>
        </div>
        <div class="ml-auto flex gap-2 flex-wrap">
            @if (Model.Status != ErrorStatus.InReview)
            {
                <form asp-action="UpdateStatus" method="post" class="inline">
                    <input type="hidden" name="id" value="@Model.Id"/>
                    <input type="hidden" name="status" value="InReview"/>
                    <button type="submit" class="bg-blue-600 text-white text-sm px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                        Marcar 'En Revisión'
                    </button>
                </form>
            }
            @if (Model.Status != ErrorStatus.Postponed)
            {
                <form asp-action="UpdateStatus" method="post" class="inline">
                    <input type="hidden" name="id" value="@Model.Id"/>
                    <input type="hidden" name="status" value="Postponed"/>
                    <button type="submit" class="bg-amber-500 text-white text-sm px-4 py-2 rounded-lg hover:bg-amber-600 transition-colors">
                        Posponer
                    </button>
                </form>
            }
            @if (Model.Status != ErrorStatus.Resolved)
            {
                <form asp-action="UpdateStatus" method="post" class="inline">
                    <input type="hidden" name="id" value="@Model.Id"/>
                    <input type="hidden" name="status" value="Resolved"/>
                    <button type="submit" class="bg-gray-600 text-white text-sm px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors">
                        Marcar resuelto
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Summary -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-sm">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Resumen</h2>
        <p class="text-gray-700 text-sm mb-6 leading-relaxed">@Model.Description</p>
        <div class="grid grid-cols-3 gap-6 border-t border-gray-100 pt-5">
            <div>
                <p class="text-xs text-gray-400 flex items-center gap-1 mb-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
                    </svg>
                    Ocurrencias
                </p>
                <p class="text-lg font-bold text-gray-900">@Model.Occurrences</p>
            </div>
            <div>
                <p class="text-xs text-gray-400 flex items-center gap-1 mb-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Sucedió por última vez
                </p>
                <p class="text-sm font-semibold text-gray-800">@FormatDate(Model.LastSeen)</p>
            </div>
            <div>
                <p class="text-xs text-gray-400 flex items-center gap-1 mb-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    Sucedió por primera vez
                </p>
                <p class="text-sm font-semibold text-gray-800">@FormatDate(Model.FirstSeen)</p>
            </div>
        </div>
        <div class="grid grid-cols-3 gap-6 border-t border-gray-100 pt-5 mt-4">
            <div>
                <p class="text-xs text-gray-400 mb-1">Programa</p>
                <p class="text-sm font-medium text-gray-800">@Model.Program</p>
            </div>
            <div>
                <p class="text-xs text-gray-400 mb-1">Módulo</p>
                <p class="text-sm font-mono text-gray-800">@Model.Module</p>
            </div>
        </div>
    </div>

    <!-- Technical Details -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-sm">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Detalles Técnicos</h2>

        <p class="text-xs text-gray-400 mb-2">Mensaje o Excepción</p>
        <div class="bg-red-50 border border-red-100 rounded-lg px-4 py-3 mb-5">
            <code class="text-red-600 text-sm font-mono break-all">@Model.ExceptionMessage</code>
        </div>

        <p class="text-xs text-gray-400 mb-2">Stack Trace</p>
        <pre class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-xs text-gray-600 font-mono overflow-auto whitespace-pre-wrap break-all">@Model.StackTrace</pre>
    </div>

    <!-- Activity Log -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Registro de actividad</h2>
        @if (Model.ActivityLog.Count == 0)
        {
            <p class="text-sm text-gray-400">Sin actividad.</p>
        }
        else
        {
            <ul class="space-y-3">
                @foreach (var entry in Model.ActivityLog.OrderByDescending(a => a.Timestamp))
                {
                    <li class="flex items-start gap-3">
                        <span class="mt-1.5 w-2 h-2 bg-emerald-500 rounded-full flex-shrink-0"></span>
                        <div>
                            <p class="text-sm text-gray-800">
                                <span class="font-semibold">@entry.User</span>
                                <span class="text-gray-500"> @entry.Message</span>
                            </p>
                            <p class="text-xs text-gray-400">@FormatDate(entry.Timestamp)</p>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
