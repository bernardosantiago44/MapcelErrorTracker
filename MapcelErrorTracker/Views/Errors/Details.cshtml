@model MapcelErrorTracker.Models.ErrorItem
@{
    ViewData["Title"] = Model.Code;
    var errorAge = DateTime.UtcNow - Model.FirstSeen;
    var ageText = errorAge.Days > 0
        ? $"{errorAge.Days}d {errorAge.Hours}h"
        : $"{errorAge.Hours}h {errorAge.Minutes}m";
    var assignedUserIds = Model.AssignedUsers.Select(user => user.Id).ToHashSet();
}

@functions {
    static string PriorityBadge(ErrorPriority p) => p switch
    {
        ErrorPriority.Alta => "bg-red-100 text-red-700 border border-red-200",
        ErrorPriority.Media => "bg-amber-100 text-amber-700 border border-amber-200",
        _ => "bg-slate-100 text-slate-600 border border-slate-200"
    };

    static string StatusBadge(ErrorStatus s) => s switch
    {
        ErrorStatus.Nuevo => "bg-teal-50 text-teal-700 border border-teal-200",
        ErrorStatus.EnRevision => "bg-blue-50 text-blue-700 border border-blue-200",
        ErrorStatus.Pospuesto => "bg-purple-50 text-purple-700 border border-purple-200",
        ErrorStatus.Resuelto => "bg-emerald-50 text-emerald-700 border border-emerald-200",
        _ => "bg-gray-100 text-gray-600 border border-gray-200"
    };

    static string StatusLabel(ErrorStatus s) => s switch
    {
        ErrorStatus.Nuevo => "Nuevo",
        ErrorStatus.EnRevision => "En Revisión",
        ErrorStatus.Pospuesto => "Pospuesto",
        ErrorStatus.Resuelto => "Resuelto",
        ErrorStatus.SinAsignar => "Sin asignar",
        _ => s.ToString()
    };

    static string PriorityLabel(ErrorPriority p) => p switch
    {
        ErrorPriority.Alta => "Alta",
        ErrorPriority.Media => "Media",
        ErrorPriority.Baja => "Baja",
        _ => p.ToString()
    };

    static string FormatDate(DateTime dt) =>
        dt.ToString("d MMM yyyy · HH:mm");

    static string FormatDateShort(DateTime dt) =>
        dt.ToString("d MMM, HH:mm");

    static bool HasValue(string? s) => !string.IsNullOrWhiteSpace(s);

    static string AssigneeCardClass(bool selected) => selected
        ? "border-teal-300 bg-teal-50 ring-1 ring-teal-200"
        : "border-gray-200 bg-white hover:border-gray-300 hover:bg-gray-50";

    static string AssignmentContact(ProgrammerUser user)
    {
        var contact = new List<string>();

        if (HasValue(user.TelegramId))
        {
            contact.Add($"Telegram: {user.TelegramId}");
        }

        if (HasValue(user.CellPhone))
        {
            contact.Add($"Cel: {user.CellPhone}");
        }

        return contact.Count == 0 ? "Sin contacto registrado" : string.Join(" · ", contact);
    }
}

<!-- Top navigation bar -->
<div class="bg-white border-b border-gray-200 px-6 py-3">
    <a asp-controller="Errors" asp-action="Index"
       class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-800 transition-colors">
        <i data-lucide="arrow-left" style="width:16px;height:16px"></i>
        Regresar al dashboard
    </a>
</div>

<!-- Two column layout -->
<div class="flex flex-col lg:flex-row gap-6 px-4 sm:px-6 py-6 max-w-screen-2xl mx-auto">

    <!-- ==================== LEFT COLUMN: Sticky summary ==================== -->
    <aside class="w-full lg:w-96 lg:flex-shrink-0">
        <div class="lg:sticky lg:top-4 space-y-4">

            <!-- 1. Incident header -->
            <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
                <div class="flex items-center gap-2 mb-2">
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @PriorityBadge(Model.Priority)">@PriorityLabel(Model.Priority)</span>
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @StatusBadge(Model.Status)">@StatusLabel(Model.Status)</span>
                    @if (Model.BlocksOperation)
                    {
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-red-600 text-white">Bloquea</span>
                    }
                </div>
                <h1 class="text-xl font-bold font-mono text-gray-900 mb-1">@Model.Code</h1>
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500">
                    <span class="flex items-center gap-1"><i data-lucide="building-2" style="width:12px;height:12px"></i> @Model.Company</span>
                    <span class="flex items-center gap-1"><i data-lucide="code-2" style="width:12px;height:12px"></i> @Model.Program</span>
                </div>
            </div>

            <!-- 2. Impact KPIs -->
            <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
                <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Impacto</h2>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-2xl font-bold text-gray-900">@Model.Occurrences</p>
                        <p class="text-xs text-gray-400">Ocurrencias</p>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-gray-900">@ageText</p>
                        <p class="text-xs text-gray-400">Edad del error</p>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-800">@FormatDateShort(Model.FirstSeen)</p>
                        <p class="text-xs text-gray-400">Primera vez</p>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-800">@FormatDateShort(Model.LastSeen)</p>
                        <p class="text-xs text-gray-400">Última vez</p>
                    </div>
                </div>
                @if (HasValue(Model.Process) || HasValue(Model.Channel))
                {
                    <div class="mt-3 pt-3 border-t border-gray-100 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500">
                        @if (HasValue(Model.Process))
                        {
                            <span><span class="text-gray-400">Proceso:</span> @Model.Process</span>
                        }
                        @if (HasValue(Model.Channel))
                        {
                            <span><span class="text-gray-400">Canal:</span> @Model.Channel</span>
                        }
                    </div>
                }
            </div>

            <!-- 3. Assignment -->
            <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
                <div class="flex items-center justify-between gap-3 mb-3">
                    <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest">Responsables</h2>
                    <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold bg-teal-50 text-teal-700 border border-teal-200">
                        @(Model.AssignedUsers.Count == 0 ? "Sin asignar" : $"{Model.AssignedUsers.Count} asignado{(Model.AssignedUsers.Count == 1 ? string.Empty : "s")}")
                    </span>
                </div>
                @if (Model.AssignedUsers.Count > 0)
                {
                    <div class="flex flex-wrap gap-2 mb-4">
                        @foreach (var user in Model.AssignedUsers)
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-3 py-1 text-sm font-semibold text-gray-700">
                                <i data-lucide="user-check" style="width:14px;height:14px"></i>
                                @user.Name
                            </span>
                        }
                    </div>
                }
                <form asp-action="AssignUsers" method="post" class="space-y-3">
                    <input type="hidden" name="id" value="@Model.Id"/>
                    @foreach (var user in Model.AvailableAssignees)
                    {
                        var isSelected = assignedUserIds.Contains(user.Id);
                        <label class="block cursor-pointer">
                            <div class="flex items-center gap-3 rounded-lg border p-3 transition-colors @AssigneeCardClass(isSelected)">
                                <input type="checkbox" name="userIds" value="@user.Id" class="h-5 w-5 flex-shrink-0" checked="@(isSelected ? "checked" : null)"/>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center justify-between gap-2">
                                        <p class="text-sm font-semibold text-gray-800 truncate">@user.Name</p>
                                        @if (isSelected)
                                        {
                                            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-teal-100 text-teal-700 flex-shrink-0">Asignado</span>
                                        }
                                    </div>
                                    <p class="text-xs text-gray-500 truncate">@AssignmentContact(user)</p>
                                </div>
                            </div>
                        </label>
                    }
                    @if (Model.AvailableAssignees.Count == 0)
                    {
                        <p class="text-sm text-gray-400 border border-dashed border-gray-200 rounded-lg p-3">
                            No hay responsables registrados.
                        </p>
                    }
                    <button type="submit" class="w-full flex items-center justify-center gap-2 bg-gray-700 text-white text-sm px-3 py-2 rounded-lg hover:bg-gray-800 transition-colors">
                        <i data-lucide="users" style="width:16px;height:16px"></i>
                        Guardar responsables
                    </button>
                </form>
            </div>

            <!-- 3. Quick actions -->
            <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
                <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Acciones</h2>
                <div class="grid grid-cols-2 gap-2 mb-3">
                    @if (Model.Status != ErrorStatus.EnRevision)
                    {
                        <form asp-action="UpdateStatus" method="post">
                            <input type="hidden" name="id" value="@Model.Id"/>
                            <input type="hidden" name="status" value="@ErrorStatus.EnRevision"/>
                            <button type="submit" class="w-full flex items-center justify-center gap-1.5 bg-blue-600 text-white text-sm px-3 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                                <i data-lucide="eye" style="width:14px;height:14px"></i> En revisión
                            </button>
                        </form>
                    }
                    @if (Model.Status != ErrorStatus.Resuelto)
                    {
                        <form asp-action="UpdateStatus" method="post">
                            <input type="hidden" name="id" value="@Model.Id"/>
                            <input type="hidden" name="status" value="@ErrorStatus.Resuelto"/>
                            <button type="submit" class="w-full flex items-center justify-center gap-1.5 bg-emerald-600 text-white text-sm px-3 py-2 rounded-lg hover:bg-emerald-700 transition-colors">
                                <i data-lucide="check-circle" style="width:14px;height:14px"></i> Resolver
                            </button>
                        </form>
                    }
                    @if (Model.Status != ErrorStatus.Pospuesto)
                    {
                        <form asp-action="UpdateStatus" method="post">
                            <input type="hidden" name="id" value="@Model.Id"/>
                            <input type="hidden" name="status" value="@ErrorStatus.Pospuesto"/>
                            <button type="submit" class="w-full flex items-center justify-center gap-1.5 bg-purple-500 text-white text-sm px-3 py-2 rounded-lg hover:bg-purple-600 transition-colors">
                                <i data-lucide="clock" style="width:14px;height:14px"></i> Posponer
                            </button>
                        </form>
                    }
                    @if (Model.Status is ErrorStatus.Resuelto or ErrorStatus.Pospuesto)
                    {
                        <form asp-action="UpdateStatus" method="post">
                            <input type="hidden" name="id" value="@Model.Id"/>
                            <input type="hidden" name="status" value="@ErrorStatus.Nuevo"/>
                            <button type="submit" class="w-full flex items-center justify-center gap-1.5 bg-teal-500 text-white text-sm px-3 py-2 rounded-lg hover:bg-teal-600 transition-colors">
                                <i data-lucide="rotate-ccw" style="width:14px;height:14px"></i> Reabrir
                            </button>
                        </form>
                    }
                </div>
                <div class="border-t border-gray-100 pt-3 space-y-2">
                    <div class="flex items-center gap-2">
                        <label class="text-xs text-gray-400 w-16">Prioridad</label>
                        <form asp-action="UpdatePriority" method="post" class="flex items-center gap-2 flex-1">
                            <input type="hidden" name="id" value="@Model.Id"/>
                            <select name="priority" class="text-sm border border-gray-200 rounded-lg px-2 py-1 bg-gray-50 flex-1 focus:outline-none focus:ring-2 focus:ring-teal-400">
                                @foreach (var p in Enum.GetValues<ErrorPriority>())
                                {
                                    <option value="@p" selected="@(Model.Priority == p ? "selected" : null)">@PriorityLabel(p)</option>
                                }
                            </select>
                            <button type="submit" class="bg-gray-700 text-white text-xs px-3 py-1.5 rounded-lg hover:bg-gray-800 transition-colors">
                                Guardar
                            </button>
                        </form>
                    </div>
                    <div class="flex items-center gap-2">
                        <label class="text-xs text-gray-400 w-16">Estado</label>
                        <form asp-action="UpdateStatus" method="post" class="flex items-center gap-2 flex-1">
                            <input type="hidden" name="id" value="@Model.Id"/>
                            <select name="status" class="text-sm border border-gray-200 rounded-lg px-2 py-1 bg-gray-50 flex-1 focus:outline-none focus:ring-2 focus:ring-teal-400">
                                @foreach (var s in Enum.GetValues<ErrorStatus>())
                                {
                                    <option value="@s" selected="@(Model.Status == s ? "selected" : null)">@StatusLabel(s)</option>
                                }
                            </select>
                            <button type="submit" class="bg-gray-700 text-white text-xs px-3 py-1.5 rounded-lg hover:bg-gray-800 transition-colors">
                                Guardar
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- 4. Tracking -->
            <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
                <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Seguimiento</h2>
                <dl class="space-y-2 text-sm">
                    @if (HasValue(Model.Assignee))
                    {
                        <div class="flex justify-between">
                            <dt class="text-gray-400">Responsables</dt>
                            <dd class="text-gray-800 font-medium">@Model.Assignee</dd>
                        </div>
                    }
                    @if (HasValue(Model.CreatedBy))
                    {
                        <div class="flex justify-between">
                            <dt class="text-gray-400">Creado por</dt>
                            <dd class="text-gray-700">@Model.CreatedBy</dd>
                        </div>
                    }
                    @if (HasValue(Model.ModifiedBy))
                    {
                        <div class="flex justify-between">
                            <dt class="text-gray-400">Modificado por</dt>
                            <dd class="text-gray-700">@Model.ModifiedBy</dd>
                        </div>
                    }
                    @if (Model.LastUpdated.HasValue)
                    {
                        <div class="flex justify-between">
                            <dt class="text-gray-400">Última actualización</dt>
                            <dd class="text-gray-700">@FormatDateShort(Model.LastUpdated.Value)</dd>
                        </div>
                    }
                    @if (Model.NextFollowUp.HasValue)
                    {
                        <div class="flex justify-between">
                            <dt class="text-gray-400">Próximo seguimiento</dt>
                            <dd class="text-gray-700 font-medium">@FormatDateShort(Model.NextFollowUp.Value)</dd>
                        </div>
                    }
                    <div class="flex justify-between">
                        <dt class="text-gray-400">Alertas</dt>
                        <dd>
                            @if (Model.IsSilenced)
                            {
                                <span class="inline-flex items-center gap-1 text-purple-600 text-xs font-medium">
                                    <i data-lucide="bell-off" style="width:12px;height:12px"></i> Silenciado
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 text-teal-600 text-xs font-medium">
                                    <i data-lucide="bell" style="width:12px;height:12px"></i> Activa
                                </span>
                            }
                        </dd>
                    </div>
                </dl>
            </div>

            <!-- 5. Notification summary -->
            @if (Model.NotificationContacts.Count > 0)
            {
                <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
                    <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Notificaciones</h2>
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-gray-400">Personas notificadas</span>
                            <span class="text-gray-800 font-medium">@Model.NotificationContacts.Count</span>
                        </div>
                        @if (Model.NotificationFrequencyMinutes > 0)
                        {
                            <div class="flex justify-between">
                                <span class="text-gray-400">Frecuencia</span>
                                <span class="text-gray-700">cada @Model.NotificationFrequencyMinutes min</span>
                            </div>
                        }
                        @if (Model.SilencedUntil.HasValue)
                        {
                            <div class="flex justify-between">
                                <span class="text-gray-400">Silenciado hasta</span>
                                <span class="text-gray-700">@FormatDateShort(Model.SilencedUntil.Value)</span>
                            </div>
                        }
                        @if (Model.LastNotificationSent.HasValue)
                        {
                            <div class="flex justify-between">
                                <span class="text-gray-400">Último aviso</span>
                                <span class="text-gray-700">@FormatDateShort(Model.LastNotificationSent.Value)</span>
                            </div>
                        }
                    </div>
                </div>
            }

        </div>
    </aside>

    <!-- ==================== RIGHT COLUMN: Scrollable detail sections ==================== -->
    <main class="flex-1 min-w-0 space-y-4">

        <!-- Section 1: Functional summary (always expanded) -->
        <section class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100">
                <h2 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                    <i data-lucide="file-text" style="width:16px;height:16px" class="text-teal-600"></i>
                    Resumen funcional
                </h2>
            </div>
            <div class="p-5">
                <div class="space-y-4">
                    <div class="bg-gray-50 rounded-lg p-4 border border-gray-100">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Qué pasó</p>
                        <p class="text-sm text-gray-800 leading-relaxed">@Model.Description</p>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="bg-gray-50 rounded-lg p-4 border border-gray-100">
                            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Dónde pasó</p>
                            <p class="text-sm text-gray-800">@Model.Company · @Model.Program</p>
                            <p class="text-xs text-gray-500 font-mono mt-0.5">@Model.Module</p>
                        </div>
                        <div class="bg-gray-50 rounded-lg p-4 border border-gray-100">
                            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Qué tan urgente es</p>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @PriorityBadge(Model.Priority)">@PriorityLabel(Model.Priority)</span>
                                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @StatusBadge(Model.Status)">@StatusLabel(Model.Status)</span>
                                @if (Model.BlocksOperation)
                                {
                                    <span class="text-xs text-red-600 font-medium">⚠ Bloquea operación</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (HasValue(Model.LatestComment) || HasValue(Model.NextStep))
                    {
                        <div class="bg-teal-50 rounded-lg p-4 border border-teal-100">
                            <p class="text-xs font-medium text-teal-600 uppercase tracking-wide mb-1">Qué se está haciendo</p>
                            @if (HasValue(Model.LatestComment))
                            {
                                <p class="text-sm text-gray-800">@Model.LatestComment</p>
                            }
                            @if (HasValue(Model.NextStep))
                            {
                                <p class="text-xs text-teal-700 mt-1">
                                    <span class="font-medium">Próximo paso:</span> @Model.NextStep
                                </p>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- Section 2: Timeline (expanded by default, collapsible) -->
        <section class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden" x-data="{ open: true }">
            <button @@click="open = !open" class="w-full px-5 py-4 flex items-center justify-between border-b border-gray-100 hover:bg-gray-50 transition-colors text-left">
                <h2 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                    <i data-lucide="clock" style="width:16px;height:16px" class="text-teal-600"></i>
                    Línea de tiempo
                    <span class="text-xs font-normal text-gray-400">(@Model.ActivityLog.Count entradas)</span>
                </h2>
                <i data-lucide="chevron-down" style="width:16px;height:16px" class="text-gray-400 transition-transform" x-bind:class="open ? 'rotate-180' : ''"></i>
            </button>
            <div x-show="open" x-transition class="p-5">
                @if (Model.ActivityLog.Count == 0)
                {
                    <p class="text-sm text-gray-400">Sin actividad registrada.</p>
                }
                else
                {
                    <div class="relative pl-6">
                        <div class="absolute left-2 top-2 bottom-2 w-px bg-gray-200"></div>
                        @foreach (var entry in Model.ActivityLog.OrderByDescending(a => a.Timestamp))
                        {
                            <div class="relative mb-4 last:mb-0">
                                <div class="absolute -left-4 top-1.5 w-2.5 h-2.5 rounded-full bg-teal-500 border-2 border-white"></div>
                                <div class="flex items-start justify-between gap-2">
                                    <div>
                                        <p class="text-sm text-gray-800">
                                            <span class="font-semibold">@entry.User</span>
                                            <span class="text-gray-500 ml-1">@entry.Message</span>
                                        </p>
                                    </div>
                                    <time class="text-xs text-gray-400 whitespace-nowrap flex-shrink-0">@FormatDateShort(entry.Timestamp)</time>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <!-- Section 3: Technical data (expanded compact, collapsible) -->
        <section class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden" x-data="{ open: true, stExpanded: false }">
            <button @@click="open = !open" class="w-full px-5 py-4 flex items-center justify-between border-b border-gray-100 hover:bg-gray-50 transition-colors text-left">
                <h2 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                    <i data-lucide="code-2" style="width:16px;height:16px" class="text-teal-600"></i>
                    Datos técnicos
                </h2>
                <i data-lucide="chevron-down" style="width:16px;height:16px" class="text-gray-400 transition-transform" x-bind:class="open ? 'rotate-180' : ''"></i>
            </button>
            <div x-show="open" x-transition class="p-5 space-y-4">
                <!-- Key-value pairs -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
                    <div>
                        <p class="text-xs text-gray-400 mb-0.5">Código error</p>
                        <p class="text-sm font-mono text-gray-800">@Model.Code</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400 mb-0.5">Programa</p>
                        <p class="text-sm text-gray-800">@Model.Program</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400 mb-0.5">Módulo</p>
                        <p class="text-sm font-mono text-gray-800">@Model.Module</p>
                    </div>
                    @if (HasValue(Model.Process))
                    {
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">Proceso</p>
                            <p class="text-sm text-gray-800">@Model.Process</p>
                        </div>
                    }
                    @if (HasValue(Model.CorrelationId))
                    {
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">ID correlación</p>
                            <p class="text-sm font-mono text-gray-800">@Model.CorrelationId</p>
                        </div>
                    }
                    @if (HasValue(Model.RequestId))
                    {
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">Request ID</p>
                            <p class="text-sm font-mono text-gray-800">@Model.RequestId</p>
                        </div>
                    }
                    @if (HasValue(Model.FolioNumber))
                    {
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">Folio</p>
                            <p class="text-sm font-mono text-gray-800">@Model.FolioNumber</p>
                        </div>
                    }
                </div>

                <!-- Exception message -->
                <div>
                    <p class="text-xs text-gray-400 mb-1.5">Mensaje de excepción</p>
                    <div class="bg-red-50 border border-red-100 rounded-lg px-4 py-3">
                        <code class="text-red-700 text-sm font-mono break-all leading-relaxed">@Model.ExceptionMessage</code>
                    </div>
                </div>

                <!-- Stack trace (collapsed preview) -->
                @if (HasValue(Model.StackTrace))
                {
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <p class="text-xs text-gray-400">Stack trace</p>
                            <div class="flex gap-2">
                                <button @@click="stExpanded = !stExpanded" class="text-xs text-teal-600 hover:text-teal-800 font-medium transition-colors"
                                        x-text="stExpanded ? 'Colapsar' : 'Expandir completo'"></button>
                                <button onclick="navigator.clipboard.writeText(document.getElementById('stack-trace-content').textContent)"
                                        class="text-xs text-gray-400 hover:text-gray-600 font-medium transition-colors flex items-center gap-1">
                                    <i data-lucide="copy" style="width:12px;height:12px"></i> Copiar
                                </button>
                            </div>
                        </div>
                        <pre id="stack-trace-content"
                             class="bg-gray-900 text-gray-300 rounded-lg p-4 text-xs font-mono overflow-auto whitespace-pre-wrap break-all transition-all"
                             x-bind:class="stExpanded ? 'max-h-[600px]' : 'max-h-28'"
                             style="line-height: 1.6">@Model.StackTrace</pre>
                    </div>
                }
            </div>
        </section>

        <!-- Section 4: Classification & context (collapsed by default) -->
        @{
            var classificationFields = new List<(string Label, string Value)>();
            if (HasValue(Model.Company)) classificationFields.Add(("Empresa", Model.Company));
            if (HasValue(Model.Environment)) classificationFields.Add(("Ambiente", Model.Environment));
            if (HasValue(Model.Channel)) classificationFields.Add(("Canal", Model.Channel));
            if (HasValue(Model.ErrorType)) classificationFields.Add(("Tipo de error", Model.ErrorType));
            if (HasValue(Model.Category)) classificationFields.Add(("Categoría", Model.Category));
            if (HasValue(Model.Subcategory)) classificationFields.Add(("Subcategoría", Model.Subcategory));
            if (HasValue(Model.Impact)) classificationFields.Add(("Impacto", Model.Impact));
            if (HasValue(Model.Severity)) classificationFields.Add(("Severidad", Model.Severity));
            if (HasValue(Model.Frequency)) classificationFields.Add(("Frecuencia", Model.Frequency));
            if (Model.IsReproducible.HasValue) classificationFields.Add(("Reproducible", Model.IsReproducible.Value ? "Sí" : "No"));
            if (HasValue(Model.OwnerArea)) classificationFields.Add(("Área dueña", Model.OwnerArea));
            if (HasValue(Model.SourceSystem)) classificationFields.Add(("Sistema origen", Model.SourceSystem));
            if (HasValue(Model.DestinationSystem)) classificationFields.Add(("Sistema destino", Model.DestinationSystem));
        }
        @if (classificationFields.Count > 0 || Model.Tags.Count > 0)
        {
            <section class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden" x-data="{ open: false }">
                <button @@click="open = !open" class="w-full px-5 py-4 flex items-center justify-between hover:bg-gray-50 transition-colors text-left">
                    <h2 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                        <i data-lucide="tags" style="width:16px;height:16px" class="text-teal-600"></i>
                        Clasificación y contexto
                        <span class="text-xs font-normal text-gray-400">(@classificationFields.Count campos)</span>
                    </h2>
                    <i data-lucide="chevron-down" style="width:16px;height:16px" class="text-gray-400 transition-transform" x-bind:class="open ? 'rotate-180' : ''"></i>
                </button>
                <div x-show="open" x-transition class="px-5 pb-5 border-t border-gray-100">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-3 pt-4">
                        @foreach (var field in classificationFields)
                        {
                            <div>
                                <p class="text-xs text-gray-400 mb-0.5">@field.Label</p>
                                <p class="text-sm text-gray-800">@field.Value</p>
                            </div>
                        }
                    </div>
                    @if (Model.Tags.Count > 0)
                    {
                        <div class="mt-4 pt-3 border-t border-gray-100">
                            <p class="text-xs text-gray-400 mb-2">Etiquetas</p>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var tag in Model.Tags)
                                {
                                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-teal-50 text-teal-700 border border-teal-200">@tag</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <!-- Section 5: Operational tracking (expanded by default) -->
        <section class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden" x-data="{ open: true }">
            <button @@click="open = !open" class="w-full px-5 py-4 flex items-center justify-between border-b border-gray-100 hover:bg-gray-50 transition-colors text-left">
                <h2 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                    <i data-lucide="clipboard-list" style="width:16px;height:16px" class="text-teal-600"></i>
                    Seguimiento operativo
                </h2>
                <i data-lucide="chevron-down" style="width:16px;height:16px" class="text-gray-400 transition-transform" x-bind:class="open ? 'rotate-180' : ''"></i>
            </button>
            <div x-show="open" x-transition class="p-5 space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
                    <div>
                        <p class="text-xs text-gray-400 mb-0.5">Estado</p>
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @StatusBadge(Model.Status)">@StatusLabel(Model.Status)</span>
                    </div>
                    @if (HasValue(Model.Assignee))
                    {
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">Responsables</p>
                            <p class="text-sm text-gray-800 font-medium">@Model.Assignee</p>
                        </div>
                    }
                    <div>
                        <p class="text-xs text-gray-400 mb-0.5">Prioridad</p>
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @PriorityBadge(Model.Priority)">@PriorityLabel(Model.Priority)</span>
                    </div>
                    @if (Model.NextFollowUp.HasValue)
                    {
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">Fecha compromiso</p>
                            <p class="text-sm text-gray-800">@FormatDate(Model.NextFollowUp.Value)</p>
                        </div>
                    }
                    @if (HasValue(Model.PostponeReason))
                    {
                        <div class="sm:col-span-2">
                            <p class="text-xs text-gray-400 mb-0.5">Motivo de posposición</p>
                            <p class="text-sm text-gray-800">@Model.PostponeReason</p>
                        </div>
                    }
                    @if (HasValue(Model.LatestComment))
                    {
                        <div class="sm:col-span-2">
                            <p class="text-xs text-gray-400 mb-0.5">Último comentario</p>
                            <p class="text-sm text-gray-800">@Model.LatestComment</p>
                        </div>
                    }
                    @if (HasValue(Model.NextStep))
                    {
                        <div class="sm:col-span-2">
                            <p class="text-xs text-gray-400 mb-0.5">Próximo paso</p>
                            <p class="text-sm text-gray-800 font-medium">@Model.NextStep</p>
                        </div>
                    }
                </div>

                <!-- Recent activity summary -->
                @if (Model.ActivityLog.Count > 0)
                {
                    <div class="border-t border-gray-100 pt-4">
                        <p class="text-xs text-gray-400 mb-2">Actividad reciente</p>
                        <div class="space-y-2">
                            @foreach (var entry in Model.ActivityLog.OrderByDescending(a => a.Timestamp).Take(3))
                            {
                                <div class="flex items-center gap-2 text-sm">
                                    <span class="w-1.5 h-1.5 bg-teal-500 rounded-full flex-shrink-0"></span>
                                    <span class="text-gray-600">
                                        <span class="font-medium text-gray-800">@entry.User</span> @entry.Message
                                    </span>
                                    <span class="text-xs text-gray-400 ml-auto whitespace-nowrap">@FormatDateShort(entry.Timestamp)</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- Section 6: Notifications (collapsed by default) -->
        @if (Model.NotificationContacts.Count > 0 || Model.IsSilenced)
        {
            <section class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden" x-data="{ open: false }">
                <button @@click="open = !open" class="w-full px-5 py-4 flex items-center justify-between hover:bg-gray-50 transition-colors text-left">
                    <h2 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                        <i data-lucide="bell" style="width:16px;height:16px" class="text-teal-600"></i>
                        Notificaciones y silencio
                        @if (Model.IsSilenced)
                        {
                            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-purple-100 text-purple-700">Silenciado</span>
                        }
                    </h2>
                    <i data-lucide="chevron-down" style="width:16px;height:16px" class="text-gray-400 transition-transform" x-bind:class="open ? 'rotate-180' : ''"></i>
                </button>
                <div x-show="open" x-transition class="px-5 pb-5 border-t border-gray-100">
                    <!-- Summary -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 mb-4">
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">Personas notificadas</p>
                            <p class="text-sm font-semibold text-gray-800">@Model.NotificationContacts.Count</p>
                        </div>
                        @if (Model.NotificationFrequencyMinutes > 0)
                        {
                            <div>
                                <p class="text-xs text-gray-400 mb-0.5">Frecuencia</p>
                                <p class="text-sm text-gray-800">cada @Model.NotificationFrequencyMinutes min</p>
                            </div>
                        }
                        @if (Model.SilencedUntil.HasValue)
                        {
                            <div>
                                <p class="text-xs text-gray-400 mb-0.5">Silenciado hasta</p>
                                <p class="text-sm text-gray-800">@FormatDateShort(Model.SilencedUntil.Value)</p>
                            </div>
                        }
                        @if (Model.LastNotificationSent.HasValue)
                        {
                            <div>
                                <p class="text-xs text-gray-400 mb-0.5">Último aviso</p>
                                <p class="text-sm text-gray-800">@FormatDateShort(Model.LastNotificationSent.Value)</p>
                            </div>
                        }
                    </div>

                    <!-- Contacts -->
                    @if (Model.NotificationContacts.Count > 0)
                    {
                        <p class="text-xs text-gray-400 mb-2">Personas notificadas</p>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var contact in Model.NotificationContacts)
                            {
                                <div class="inline-flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-sm">
                                    <div class="w-7 h-7 bg-teal-100 text-teal-700 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0">
                                        @contact.Name[0]
                                    </div>
                                    <div>
                                        <p class="text-gray-800 font-medium text-xs">@contact.Name</p>
                                        <p class="text-gray-400 text-xs">@contact.Role</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        <!-- Section 7: Additional fields (collapsed by default, hide empty) -->
        @{
            var additionalFields = new List<(string Label, string Value)>();
            if (HasValue(Model.Location)) additionalFields.Add(("Ubicación", Model.Location));
            if (HasValue(Model.FolioNumber)) additionalFields.Add(("Número de folio", Model.FolioNumber));
            if (HasValue(Model.AdditionalComments)) additionalFields.Add(("Comentarios adicionales", Model.AdditionalComments));
            if (HasValue(Model.ModifiedBy)) additionalFields.Add(("Modificado por", Model.ModifiedBy));
        }
        @if (additionalFields.Count > 0)
        {
            <section class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden" x-data="{ open: false }">
                <button @@click="open = !open" class="w-full px-5 py-4 flex items-center justify-between hover:bg-gray-50 transition-colors text-left">
                    <h2 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                        <i data-lucide="more-horizontal" style="width:16px;height:16px" class="text-teal-600"></i>
                        Campos adicionales
                        <span class="text-xs font-normal text-gray-400">(@additionalFields.Count campos)</span>
                    </h2>
                    <i data-lucide="chevron-down" style="width:16px;height:16px" class="text-gray-400 transition-transform" x-bind:class="open ? 'rotate-180' : ''"></i>
                </button>
                <div x-show="open" x-transition class="px-5 pb-5 border-t border-gray-100">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 pt-4">
                        @foreach (var field in additionalFields)
                        {
                            <div>
                                <p class="text-xs text-gray-400 mb-0.5">@field.Label</p>
                                <p class="text-sm text-gray-800">@field.Value</p>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- Section 8: Payload / raw data (collapsed by default) -->
        @if (HasValue(Model.RequestPayload) || HasValue(Model.ResponsePayload) || HasValue(Model.RawHeaders))
        {
            <section class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden" x-data="{ open: false, tab: 'request' }">
                <button @@click="open = !open" class="w-full px-5 py-4 flex items-center justify-between hover:bg-gray-50 transition-colors text-left">
                    <h2 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                        <i data-lucide="braces" style="width:16px;height:16px" class="text-teal-600"></i>
                        Payload / datos crudos
                    </h2>
                    <i data-lucide="chevron-down" style="width:16px;height:16px" class="text-gray-400 transition-transform" x-bind:class="open ? 'rotate-180' : ''"></i>
                </button>
                <div x-show="open" x-transition class="px-5 pb-5 border-t border-gray-100">
                    <!-- Tabs -->
                    <div class="flex gap-1 pt-4 mb-3 border-b border-gray-100">
                        @if (HasValue(Model.RequestPayload))
                        {
                            <button @@click="tab = 'request'" class="px-3 py-1.5 text-xs font-medium rounded-t-lg transition-colors"
                                    x-bind:class="tab === 'request' ? 'bg-gray-900 text-white' : 'text-gray-500 hover:text-gray-700'">Request</button>
                        }
                        @if (HasValue(Model.ResponsePayload))
                        {
                            <button @@click="tab = 'response'" class="px-3 py-1.5 text-xs font-medium rounded-t-lg transition-colors"
                                    x-bind:class="tab === 'response' ? 'bg-gray-900 text-white' : 'text-gray-500 hover:text-gray-700'">Response</button>
                        }
                        @if (HasValue(Model.RawHeaders))
                        {
                            <button @@click="tab = 'headers'" class="px-3 py-1.5 text-xs font-medium rounded-t-lg transition-colors"
                                    x-bind:class="tab === 'headers' ? 'bg-gray-900 text-white' : 'text-gray-500 hover:text-gray-700'">Headers</button>
                        }
                    </div>
                    @if (HasValue(Model.RequestPayload))
                    {
                        <pre x-show="tab === 'request'" class="bg-gray-900 text-gray-300 rounded-lg p-4 text-xs font-mono overflow-auto whitespace-pre-wrap break-all max-h-72">@Model.RequestPayload</pre>
                    }
                    @if (HasValue(Model.ResponsePayload))
                    {
                        <pre x-show="tab === 'response'" class="bg-gray-900 text-gray-300 rounded-lg p-4 text-xs font-mono overflow-auto whitespace-pre-wrap break-all max-h-72">@Model.ResponsePayload</pre>
                    }
                    @if (HasValue(Model.RawHeaders))
                    {
                        <pre x-show="tab === 'headers'" class="bg-gray-900 text-gray-300 rounded-lg p-4 text-xs font-mono overflow-auto whitespace-pre-wrap break-all max-h-72">@Model.RawHeaders</pre>
                    }
                </div>
            </section>
        }

    </main>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js" defer></script>
}
