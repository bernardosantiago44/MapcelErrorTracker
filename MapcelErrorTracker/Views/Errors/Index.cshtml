@model MapcelErrorTracker.Models.ErrorListViewModel
@using System.Globalization
@using MapcelErrorTracker.Models
@{
    ViewData["Title"] = "Errores";

    var q = Model.Query;
    var returnUrl = Context.Request.Path.ToString() + Context.Request.QueryString.ToString();
    var currentSort = q.SortBy;
    var currentDirection = q.SafeSortDirection;

    void AddQueryValue(List<string> values, string name, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
            values.Add($"{name}={Uri.EscapeDataString(value)}");
    }

    string BuildUrl(
        string? sortBy = null,
        string? sortDirection = null,
        int? page = null,
        int? pageSize = null,
        bool clearFilters = false)
    {
        var values = new List<string>();

        if (!clearFilters)
        {
            AddQueryValue(values, "search", q.Search);
            AddQueryValue(values, "company", q.Company);
            AddQueryValue(values, "program", q.Program);
            AddQueryValue(values, "status", q.Status);
            AddQueryValue(values, "priority", q.Priority);
        }

        AddQueryValue(values, "sortBy", sortBy ?? currentSort);
        AddQueryValue(values, "sortDirection", sortDirection ?? currentDirection);
        values.Add($"page={(page ?? Model.CurrentPage).ToString(CultureInfo.InvariantCulture)}");
        values.Add($"pageSize={(pageSize ?? Model.PageSize).ToString(CultureInfo.InvariantCulture)}");

        return "/Errors" + (values.Count == 0 ? string.Empty : "?" + string.Join("&", values));
    }

    bool IsCurrentSort(string sortBy) =>
        string.Equals(currentSort, sortBy, StringComparison.OrdinalIgnoreCase);

    bool DefaultsDescending(string sortBy) =>
        sortBy is ErrorListSortFields.Priority or
            ErrorListSortFields.Occurrences or
            ErrorListSortFields.FirstSeen or
            ErrorListSortFields.LastSeen;

    string NextSortDirection(string sortBy)
    {
        if (!IsCurrentSort(sortBy))
            return DefaultsDescending(sortBy) ? "desc" : "asc";

        return string.Equals(currentDirection, "asc", StringComparison.OrdinalIgnoreCase) ? "desc" : "asc";
    }

    string SortUrl(string sortBy) => BuildUrl(sortBy: sortBy, sortDirection: NextSortDirection(sortBy), page: 1);

    string SortIcon(string sortBy)
    {
        if (!IsCurrentSort(sortBy))
            return "arrow-up-down";

        return string.Equals(currentDirection, "asc", StringComparison.OrdinalIgnoreCase)
            ? "arrow-up"
            : "arrow-down";
    }
}

@functions {
    static string PriorityLabel(ErrorPriority priority) => priority switch
    {
        ErrorPriority.Alta => "Alta",
        ErrorPriority.Media => "Media",
        ErrorPriority.Baja => "Baja",
        _ => priority.ToString()
    };

    static string PriorityClass(ErrorPriority priority) => priority switch
    {
        ErrorPriority.Alta => "priority-high",
        ErrorPriority.Media => "priority-medium",
        _ => "priority-low"
    };

    static string StatusLabel(ErrorStatus status) => status switch
    {
        ErrorStatus.New => "Nuevo",
        ErrorStatus.InReview => "En revision",
        ErrorStatus.Postponed => "Pospuesto",
        ErrorStatus.Resolved => "Resuelto",
        _ => status.ToString()
    };

    static string StatusClass(ErrorStatus status) => status switch
    {
        ErrorStatus.New => "status-new",
        ErrorStatus.InReview => "status-review",
        ErrorStatus.Postponed => "status-postponed",
        ErrorStatus.Resolved => "status-resolved",
        _ => "status-default"
    };

    static string OccurrenceClass(int occurrences) => occurrences switch
    {
        >= 100 => "occurrence-high",
        >= 25 => "occurrence-medium",
        _ => "occurrence-low"
    };

    static string FormatDate(DateTime date) =>
        date.ToString("dd MMM yyyy HH:mm", CultureInfo.CurrentCulture);

    static string ShortMessage(string message)
    {
        const int maxLength = 130;
        if (string.IsNullOrWhiteSpace(message) || message.Length <= maxLength)
            return message;

        return message[..maxLength] + "...";
    }

    static bool Selected(string? current, object option) =>
        string.Equals(current, option.ToString(), StringComparison.OrdinalIgnoreCase);
}

<style>
    .errors-page {
        min-height: 100vh;
        background: #f8fafc;
        color: #0f172a;
        padding: 24px;
    }

    .errors-shell {
        max-width: 1440px;
        margin: 0 auto;
    }

    .errors-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 16px;
    }

    .errors-title h1 {
        margin: 0;
        font-size: 24px;
        line-height: 1.2;
        font-weight: 700;
    }

    .errors-title p {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    .summary-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #fff;
        padding: 8px 12px;
        color: #475569;
        font-size: 13px;
        white-space: nowrap;
    }

    .filter-panel,
    .table-panel,
    .state-panel {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
    }

    .filter-panel {
        margin-bottom: 14px;
        padding: 14px;
    }

    .filters-grid {
        display: grid;
        grid-template-columns: minmax(220px, 1.4fr) repeat(4, minmax(140px, 1fr)) auto auto;
        gap: 10px;
        align-items: end;
    }

    .field label {
        display: block;
        margin-bottom: 5px;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
    }

    .field input,
    .field select {
        width: 100%;
        height: 36px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #fff;
        padding: 0 10px;
        color: #0f172a;
        font-size: 14px;
    }

    .field input:focus,
    .field select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgb(37 99 235 / 0.14);
        outline: none;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 34px;
        border: 1px solid transparent;
        border-radius: 6px;
        padding: 0 11px;
        color: #334155;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
    }

    .btn svg {
        width: 15px;
        height: 15px;
    }

    .btn-primary {
        background: #2563eb;
        color: #fff;
    }

    .btn-secondary {
        border-color: #cbd5e1;
        background: #fff;
    }

    .btn-link {
        border-color: #cbd5e1;
        background: #f8fafc;
    }

    .btn-review {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .btn-postpone {
        background: #fffbeb;
        color: #b45309;
    }

    .btn-resolve {
        background: #ecfdf5;
        color: #047857;
    }

    .btn[disabled] {
        opacity: 0.42;
        cursor: not-allowed;
    }

    .state-panel {
        padding: 34px 20px;
        text-align: center;
    }

    .state-panel h2 {
        margin: 0 0 6px;
        font-size: 18px;
        font-weight: 700;
    }

    .state-panel p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }

    .state-error {
        border-color: #fecaca;
        background: #fef2f2;
        color: #991b1b;
    }

    .state-loading {
        margin-bottom: 14px;
        padding: 12px 14px;
        text-align: left;
        color: #1d4ed8;
        background: #eff6ff;
        border-color: #bfdbfe;
    }

    .table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px solid #e2e8f0;
        padding: 12px 14px;
    }

    .table-toolbar p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
    }

    .table-scroll {
        overflow-x: auto;
    }

    .errors-table {
        width: 100%;
        min-width: 1120px;
        border-collapse: collapse;
    }

    .errors-table th {
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        padding: 10px 12px;
        color: #475569;
        font-size: 12px;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .errors-table td {
        border-bottom: 1px solid #f1f5f9;
        padding: 10px 12px;
        vertical-align: middle;
        color: #334155;
        font-size: 13px;
    }

    .errors-table tr:hover td {
        background: #f8fafc;
    }

    .sort-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: inherit;
        text-decoration: none;
    }

    .sort-link svg {
        width: 13px;
        height: 13px;
    }

    .code-link {
        color: #0f172a;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-weight: 800;
        text-decoration: none;
    }

    .code-link:hover {
        color: #2563eb;
    }

    .path-cell {
        min-width: 170px;
        color: #475569;
    }

    .path-cell span {
        display: block;
        color: #94a3b8;
        font-size: 12px;
    }

    .message-cell {
        max-width: 320px;
        color: #334155;
        line-height: 1.35;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 4px 8px;
        font-size: 12px;
        font-weight: 800;
        line-height: 1;
        white-space: nowrap;
    }

    .status-new {
        border: 1px solid #bfdbfe;
        background: #eff6ff;
        color: #1d4ed8;
    }

    .status-review {
        border: 1px solid #c4b5fd;
        background: #f5f3ff;
        color: #6d28d9;
    }

    .status-postponed {
        border: 1px solid #fde68a;
        background: #fffbeb;
        color: #b45309;
    }

    .status-resolved {
        border: 1px solid #bbf7d0;
        background: #f0fdf4;
        color: #15803d;
    }

    .status-default,
    .priority-low,
    .occurrence-low {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #475569;
    }

    .priority-high,
    .occurrence-high {
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #b91c1c;
    }

    .priority-medium,
    .occurrence-medium {
        border: 1px solid #fde68a;
        background: #fffbeb;
        color: #b45309;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        min-width: 360px;
    }

    .actions form {
        display: inline-flex;
    }

    .pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
    }

    .pager-info {
        color: #64748b;
        font-size: 13px;
    }

    .pager-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    @@media (max-width: 1100px) {
        .filters-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 760px) {
        .errors-page {
            padding: 14px;
        }

        .errors-header,
        .table-toolbar,
        .pager {
            align-items: stretch;
            flex-direction: column;
        }

        .filters-grid {
            grid-template-columns: 1fr;
        }

        .table-scroll {
            overflow: visible;
        }

        .errors-table {
            min-width: 0;
        }

        .errors-table thead {
            display: none;
        }

        .errors-table,
        .errors-table tbody,
        .errors-table tr,
        .errors-table td {
            display: block;
            width: 100%;
        }

        .errors-table tbody {
            padding: 10px;
            background: #f8fafc;
        }

        .errors-table tr {
            margin-bottom: 10px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #fff;
        }

        .errors-table td {
            display: grid;
            grid-template-columns: 116px minmax(0, 1fr);
            gap: 10px;
            border-bottom: 1px solid #f1f5f9;
            padding: 10px;
        }

        .errors-table td::before {
            content: attr(data-label);
            color: #64748b;
            font-size: 12px;
            font-weight: 800;
        }

        .errors-table td:last-child {
            border-bottom: 0;
        }

        .message-cell,
        .path-cell {
            max-width: none;
            min-width: 0;
        }

        .actions {
            min-width: 0;
        }

        .actions .btn {
            flex: 1 1 130px;
        }
    }
</style>

<div class="errors-page">
    <div class="errors-shell">
        <header class="errors-header">
            <div class="errors-title">
                <h1>Errores activos</h1>
                <p>Errores abiertos con actividad reciente y estado operativo.</p>
            </div>

            <div class="summary-pill" aria-label="Resumen de registros">
                <i data-lucide="list-filter"></i>
                <span><strong>@Model.FilteredRecords</strong> visibles</span>
                <span><strong>@Model.TotalRecords</strong> totales</span>
            </div>
        </header>

        <section class="filter-panel" aria-label="Filtros de errores">
            <form method="get" asp-action="Index" id="errorFilters">
                <input type="hidden" name="sortBy" value="@q.SortBy" />
                <input type="hidden" name="sortDirection" value="@q.SafeSortDirection" />
                <input type="hidden" name="page" value="1" />

                <div class="filters-grid">
                    <div class="field">
                        <label for="search">Busqueda</label>
                        <input id="search" name="search" type="search" value="@q.Search" placeholder="Codigo, empresa, programa o mensaje" />
                    </div>

                    <div class="field">
                        <label for="company">Empresa</label>
                        <input id="company" name="company" type="search" value="@q.Company" list="company-options" placeholder="Todas" />
                        <datalist id="company-options">
                            @foreach (var company in Model.Companies)
                            {
                                <option value="@company"></option>
                            }
                        </datalist>
                    </div>

                    <div class="field">
                        <label for="program">Programa</label>
                        <input id="program" name="program" type="search" value="@q.Program" list="program-options" placeholder="Todos" />
                        <datalist id="program-options">
                            @foreach (var program in Model.Programs)
                            {
                                <option value="@program"></option>
                            }
                        </datalist>
                    </div>

                    <div class="field">
                        <label for="status">Estado</label>
                        <select id="status" name="status">
                            <option value="">Activos</option>
                            @foreach (var status in Enum.GetValues<ErrorStatus>())
                            {
                                <option value="@status" selected="@(Selected(q.Status, status) ? "selected" : null)">@StatusLabel(status)</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="priority">Prioridad</label>
                        <select id="priority" name="priority">
                            <option value="">Todas</option>
                            @foreach (var priority in Enum.GetValues<ErrorPriority>())
                            {
                                <option value="@priority" selected="@(Selected(q.Priority, priority) ? "selected" : null)">@PriorityLabel(priority)</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="pageSize">Tamano</label>
                        <select id="pageSize" name="pageSize">
                            @foreach (var size in new[] { 10, 25, 50 })
                            {
                                <option value="@size" selected="@(Model.PageSize == size ? "selected" : null)">@size</option>
                            }
                        </select>
                    </div>

                    <div class="actions">
                        <button type="submit" class="btn btn-primary">
                            <i data-lucide="search"></i>
                            Aplicar
                        </button>
                        <a href="@BuildUrl(clearFilters: true, page: 1)" class="btn btn-secondary">
                            <i data-lucide="x"></i>
                            Limpiar
                        </a>
                    </div>
                </div>
            </form>
        </section>

        <div id="loadingState" class="state-panel state-loading" hidden>
            <strong>Cargando errores...</strong>
        </div>

        @if (Model.HasError)
        {
            <section class="state-panel state-error" role="alert">
                <h2>No se pudo cargar la lista</h2>
                <p>@Model.ErrorMessage</p>
            </section>
        }
        else if (!Model.HasResults)
        {
            <section class="state-panel">
                @if (Model.HasFilters)
                {
                    <h2>Sin resultados</h2>
                    <p>No hay errores que coincidan con los filtros actuales.</p>
                    <p style="margin-top: 14px;">
                        <a href="@BuildUrl(clearFilters: true, page: 1)" class="btn btn-primary">Limpiar filtros</a>
                    </p>
                }
                else
                {
                    <h2>No hay errores activos</h2>
                    <p>La lista principal esta vacia.</p>
                }
            </section>
        }
        else
        {
            <section class="table-panel" aria-label="Lista de errores">
                <div class="table-toolbar">
                    <p>
                        Pagina <strong>@Model.CurrentPage</strong> de <strong>@Model.TotalPages</strong>
                        <span aria-hidden="true"> | </span>
                        Tamano <strong>@Model.PageSize</strong>
                    </p>
                    <p>
                        Mostrando <strong>@Model.FirstRecord-@Model.LastRecord</strong> de <strong>@Model.FilteredRecords</strong>
                        @if (Model.FilteredRecords != Model.TotalRecords)
                        {
                            <span>filtrados de <strong>@Model.TotalRecords</strong> totales</span>
                        }
                    </p>
                </div>

                <div class="table-scroll">
                    <table class="errors-table">
                        <thead>
                            <tr>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.Status)" class="sort-link">
                                        Status
                                        <i data-lucide="@SortIcon(ErrorListSortFields.Status)"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.Priority)" class="sort-link">
                                        Priority
                                        <i data-lucide="@SortIcon(ErrorListSortFields.Priority)"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.Company)" class="sort-link">
                                        Company
                                        <i data-lucide="@SortIcon(ErrorListSortFields.Company)"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.ErrorCode)" class="sort-link">
                                        Error Code
                                        <i data-lucide="@SortIcon(ErrorListSortFields.ErrorCode)"></i>
                                    </a>
                                </th>
                                <th>Program &gt; Module</th>
                                <th>Short Message</th>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.Occurrences)" class="sort-link">
                                        # of Occurrences
                                        <i data-lucide="@SortIcon(ErrorListSortFields.Occurrences)"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.FirstSeen)" class="sort-link">
                                        First Seen
                                        <i data-lucide="@SortIcon(ErrorListSortFields.FirstSeen)"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.LastSeen)" class="sort-link">
                                        Last Seen
                                        <i data-lucide="@SortIcon(ErrorListSortFields.LastSeen)"></i>
                                    </a>
                                </th>
                                <th>Quick Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var error in Model.Errors)
                            {
                                <tr>
                                    <td data-label="Status">
                                        <span class="badge @StatusClass(error.Status)">@StatusLabel(error.Status)</span>
                                    </td>
                                    <td data-label="Priority">
                                        <span class="badge @PriorityClass(error.Priority)">@PriorityLabel(error.Priority)</span>
                                    </td>
                                    <td data-label="Company">@error.Company</td>
                                    <td data-label="Error Code">
                                        <a asp-action="Details" asp-route-id="@error.Id" class="code-link">@error.Code</a>
                                    </td>
                                    <td data-label="Program > Module" class="path-cell">
                                        @error.Program
                                        <span>@error.Module</span>
                                    </td>
                                    <td data-label="Short Message" class="message-cell">@ShortMessage(error.Description)</td>
                                    <td data-label="# of Occurrences">
                                        <span class="badge @OccurrenceClass(error.Occurrences)">@error.Occurrences</span>
                                    </td>
                                    <td data-label="First Seen">@FormatDate(error.FirstSeen)</td>
                                    <td data-label="Last Seen">@FormatDate(error.LastSeen)</td>
                                    <td data-label="Quick Actions">
                                        <div class="actions">
                                            <a asp-action="Details" asp-route-id="@error.Id" class="btn btn-link">
                                                <i data-lucide="eye"></i>
                                                View details
                                            </a>

                                            <form asp-action="UpdateStatusFromList" method="post">
                                                <input type="hidden" name="id" value="@error.Id" />
                                                <input type="hidden" name="status" value="InReview" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="btn btn-review" disabled="@(error.Status == ErrorStatus.InReview)">
                                                    <i data-lucide="clipboard-search"></i>
                                                    Under review
                                                </button>
                                            </form>

                                            <form asp-action="UpdateStatusFromList" method="post">
                                                <input type="hidden" name="id" value="@error.Id" />
                                                <input type="hidden" name="status" value="Postponed" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="btn btn-postpone" disabled="@(error.Status == ErrorStatus.Postponed)">
                                                    <i data-lucide="clock-3"></i>
                                                    Postpone
                                                </button>
                                            </form>

                                            <form asp-action="UpdateStatusFromList" method="post">
                                                <input type="hidden" name="id" value="@error.Id" />
                                                <input type="hidden" name="status" value="Resolved" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="btn btn-resolve" disabled="@(error.Status == ErrorStatus.Resolved)">
                                                    <i data-lucide="check-check"></i>
                                                    Resolve
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <nav class="pager" aria-label="Paginacion">
                    <div class="pager-info">
                        Pagina @Model.CurrentPage de @Model.TotalPages
                    </div>
                    <div class="pager-actions">
                        @if (Model.HasPreviousPage)
                        {
                            <a href="@BuildUrl(page: Model.CurrentPage - 1)" class="btn btn-secondary">
                                <i data-lucide="chevron-left"></i>
                                Previous
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-secondary" aria-disabled="true">
                                <i data-lucide="chevron-left"></i>
                                Previous
                            </span>
                        }

                        @if (Model.HasNextPage)
                        {
                            <a href="@BuildUrl(page: Model.CurrentPage + 1)" class="btn btn-secondary">
                                Next
                                <i data-lucide="chevron-right"></i>
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-secondary" aria-disabled="true">
                                Next
                                <i data-lucide="chevron-right"></i>
                            </span>
                        }
                    </div>
                </nav>
            </section>
        }
    </div>
</div>

@section Scripts {
    <script>
        const loadingState = document.getElementById('loadingState');

        function showLoadingState() {
            if (!loadingState) return;
            loadingState.hidden = false;
        }

        document.getElementById('errorFilters')?.addEventListener('submit', showLoadingState);

        document.querySelectorAll('.sort-link, .pager a').forEach((link) => {
            link.addEventListener('click', showLoadingState);
        });

        if (window.renderLucide) {
            window.renderLucide();
        }
    </script>
}
