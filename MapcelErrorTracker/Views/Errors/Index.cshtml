@model MapcelErrorTracker.Models.ErrorListViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Errores";

    var q = Model.Query;
    var returnUrl = Context.Request.Path.ToString() + Context.Request.QueryString.ToString();
    var currentSort = q.SortBy;
    var currentDirection = q.SafeSortDirection;

    void AddQueryValue(List<string> values, string name, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
            values.Add($"{name}={Uri.EscapeDataString(value)}");
    }

    string BuildUrl(
        string? sortBy = null,
        string? sortDirection = null,
        int? page = null,
        int? pageSize = null,
        bool clearFilters = false)
    {
        var values = new List<string>();

        if (!clearFilters)
        {
            AddQueryValue(values, "search", q.Search);
            AddQueryValue(values, "company", q.Company);
            AddQueryValue(values, "program", q.Program);
            AddQueryValue(values, "status", q.Status);
            AddQueryValue(values, "priority", q.Priority);
        }

        AddQueryValue(values, "sortBy", sortBy ?? currentSort);
        AddQueryValue(values, "sortDirection", sortDirection ?? currentDirection);
        values.Add($"page={(page ?? Model.CurrentPage).ToString(CultureInfo.InvariantCulture)}");
        values.Add($"pageSize={(pageSize ?? Model.PageSize).ToString(CultureInfo.InvariantCulture)}");

        return "/Errors" + (values.Count == 0 ? string.Empty : "?" + string.Join("&", values));
    }

    bool IsCurrentSort(string sortBy) =>
        string.Equals(currentSort, sortBy, StringComparison.OrdinalIgnoreCase);

    bool DefaultsDescending(string sortBy) =>
        sortBy is ErrorListSortFields.Priority or
            ErrorListSortFields.Occurrences or
            ErrorListSortFields.FirstSeen or
            ErrorListSortFields.LastSeen;

    string NextSortDirection(string sortBy)
    {
        if (!IsCurrentSort(sortBy))
            return DefaultsDescending(sortBy) ? "desc" : "asc";

        return string.Equals(currentDirection, "asc", StringComparison.OrdinalIgnoreCase) ? "desc" : "asc";
    }

    string SortUrl(string sortBy) => BuildUrl(sortBy: sortBy, sortDirection: NextSortDirection(sortBy), page: 1);

    string SortIcon(string sortBy)
    {
        if (!IsCurrentSort(sortBy))
            return "arrow-up-down";

        return string.Equals(currentDirection, "asc", StringComparison.OrdinalIgnoreCase)
            ? "arrow-up"
            : "arrow-down";
    }
}

@functions {
    static string PriorityLabel(ErrorPriority priority) => priority switch
    {
        ErrorPriority.Alta => "Alta",
        ErrorPriority.Media => "Media",
        ErrorPriority.Baja => "Baja",
        _ => priority.ToString()
    };

    static string PriorityClass(ErrorPriority priority) => priority switch
    {
        ErrorPriority.Alta => "priority-high",
        ErrorPriority.Media => "priority-medium",
        _ => "priority-low"
    };

    static string StatusLabel(ErrorStatus status) => status switch
    {
        ErrorStatus.New => "Nuevo",
        ErrorStatus.InReview => "En revision",
        ErrorStatus.Postponed => "Pospuesto",
        ErrorStatus.Resolved => "Resuelto",
        _ => status.ToString()
    };

    static string StatusClass(ErrorStatus status) => status switch
    {
        ErrorStatus.New => "status-new",
        ErrorStatus.InReview => "status-review",
        ErrorStatus.Postponed => "status-postponed",
        ErrorStatus.Resolved => "status-resolved",
        _ => "status-default"
    };

    static string OccurrenceClass(int occurrences) => occurrences switch
    {
        >= 100 => "occurrence-high",
        >= 25 => "occurrence-medium",
        _ => "occurrence-low"
    };

    static string FormatDate(DateTime date) =>
        date.ToString("dd MMM yyyy HH:mm", CultureInfo.CurrentCulture);

    static string RelativeDate(DateTime date)
    {
        var difference = DateTime.UtcNow - date;

        if (difference.TotalSeconds < 60)
            return "hace un momento";

        if (difference.TotalMinutes < 60)
        {
            var minutes = Math.Max(1, (int)difference.TotalMinutes);
            return $"hace {minutes} minuto{(minutes == 1 ? string.Empty : "s")}";
        }

        if (difference.TotalHours < 24)
        {
            var hours = Math.Max(1, (int)difference.TotalHours);
            return $"hace {hours} hora{(hours == 1 ? string.Empty : "s")}";
        }

        if (difference.TotalDays < 30)
        {
            var days = Math.Max(1, (int)difference.TotalDays);
            return $"hace {days} día{(days == 1 ? string.Empty : "s")}";
        }

        if (difference.TotalDays < 365)
        {
            var months = Math.Max(1, (int)(difference.TotalDays / 30));
            return $"hace {months} mes{(months == 1 ? string.Empty : "es")}";
        }

        var years = Math.Max(1, (int)(difference.TotalDays / 365));
        return $"hace {years} año{(years == 1 ? string.Empty : "s")}";
    }

    static string ShortMessage(string message)
    {
        const int maxLength = 130;
        if (string.IsNullOrWhiteSpace(message) || message.Length <= maxLength)
            return message;

        return message[..maxLength] + "...";
    }

    static bool Selected(string? current, object option) =>
        string.Equals(current, option.ToString(), StringComparison.OrdinalIgnoreCase);
}

<link rel="stylesheet" href="~/css/error-grid.css" asp-append-version="true" />

<style>
    @@media (max-width: 1100px) {
        .filters-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 760px) {
        .errors-page {
            padding: 14px;
        }

        .errors-header,
        .table-toolbar,
        .pager {
            align-items: stretch;
            flex-direction: column;
        }

        .filters-grid {
            grid-template-columns: 1fr;
        }

        .table-scroll {
            overflow: visible;
        }

        .errors-table {
            min-width: 0;
        }

        .errors-table thead {
            display: none;
        }

     

        .errors-table,
        .errors-table tbody,
        .errors-table tr,
        .errors-table td {
            display: block;
            width: 100%;
        }

        .errors-table tbody {
            padding: 10px;
            background: #f8fafc;
        }

        .errors-table tr {
            margin-bottom: 10px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #fff;
        }

        .errors-table td {
            display: grid;
            grid-template-columns: 116px minmax(0, 1fr);
            gap: 10px;
            border-bottom: 1px solid #f1f5f9;
            padding: 10px;
        }

        .errors-table td::before {
            content: attr(data-label);
            color: #64748b;
            font-size: 12px;
            font-weight: 800;
        }

        .errors-table td:last-child {
            border-bottom: 0;
        }

        .message-cell,
        .path-cell {
            max-width: none;
            min-width: 0;
        }

        .actions {
            min-width: 0;
        }

        .actions .btn {
            flex: 1 1 130px;
        }

        .row-actions {
            display: flex;
            min-width: 0;
            width: 100%;
        }

        .row-actions .btn,
        .status-dropdown-form,
        .status-dropdown-trigger {
            flex: 1 1 0;
        }
    }
</style>

<div class="errors-page">
    <div class="errors-shell">
        <div class="sticky-grid-controls">
            <header class="errors-header">
                <div class="errors-title">
                    <h1>Errores del sistema</h1>
                    <p>Errores abiertos con actividad reciente y estado operativo.</p>
                </div>

                <div class="summary-pill" aria-label="Resumen de registros">
                    <i data-lucide="list-filter"></i>
                    <span><strong>@Model.FilteredRecords</strong> visibles</span>
                    <span><strong>@Model.TotalRecords</strong> totales</span>
                </div>
            </header>

            <section class="filter-panel" aria-label="Filtros de errores">
                <form method="get" asp-action="Index" id="errorFilters">
                    <input type="hidden" name="sortBy" value="@q.SortBy" />
                    <input type="hidden" name="sortDirection" value="@q.SafeSortDirection" />
                    <input type="hidden" name="page" value="1" />

                    <div class="filters-grid">
                        <div class="field">
                            <label for="search">Búsqueda</label>
                            <input id="search" name="search" type="search" value="@q.Search" placeholder="Codigo, empresa o mensaje" />
                        </div>

                        <div class="field">
                            <label for="company">Empresa</label>
                            <input id="company" name="company" type="search" value="@q.Company" list="company-options" placeholder="Todas" />
                            <datalist id="company-options">
                                @foreach (var company in Model.Companies)
                                {
                                    <option value="@company"></option>
                                }
                            </datalist>
                        </div>

                        <div class="field">
                            <label for="program">Programa</label>
                            <input id="program" name="program" type="search" value="@q.Program" list="program-options" placeholder="Todos" />
                            <datalist id="program-options">
                                @foreach (var program in Model.Programs)
                                {
                                    <option value="@program"></option>
                                }
                            </datalist>
                        </div>

                        <div class="field">
                            <label for="status">Estado</label>
                            <select id="status" name="status">
                                <option value="">Todos</option>
                                @foreach (var status in Enum.GetValues<ErrorStatus>())
                                {
                                    <option value="@status" selected="@(Selected(q.Status, status) ? "selected" : null)">@StatusLabel(status)</option>
                                }
                            </select>
                        </div>

                        <div class="field">
                            <label for="priority">Prioridad</label>
                            <select id="priority" name="priority">
                                <option value="">Todas</option>
                                @foreach (var priority in Enum.GetValues<ErrorPriority>())
                                {
                                    <option value="@priority" selected="@(Selected(q.Priority, priority) ? "selected" : null)">@PriorityLabel(priority)</option>
                                }
                            </select>
                        </div>

                        <div class="field">
                            <label for="pageSize">Tamaño</label>
                            <select id="pageSize" name="pageSize">
                                @foreach (var size in new[] { 5, 10, 25, 50 })
                                {
                                    <option value="@size" selected="@(Model.PageSize == size ? "selected" : null)">@size</option>
                                }
                            </select>
                        </div>

                        <div class="actions">
                            <button type="submit" class="btn btn-primary">
                                <i data-lucide="search"></i>
                                Aplicar
                            </button>
                            <a href="@BuildUrl(clearFilters: true, page: 1)" class="btn btn-secondary">
                                <i data-lucide="x"></i>
                                Limpiar
                            </a>
                        </div>
                    </div>
                </form>
            </section>
        </div>

        <div id="loadingState" class="state-panel state-loading" hidden>
            <strong>Cargando errores...</strong>
        </div>

        @if (Model.HasError)
        {
            <section class="state-panel state-error" role="alert">
                <h2>No se pudo cargar la lista</h2>
                <p>@Model.ErrorMessage</p>
            </section>
        }
        else if (!Model.HasResults)
        {
            <section class="state-panel">
                @if (Model.HasFilters)
                {
                    <h2>Sin resultados</h2>
                    <p>No hay errores que coincidan con los filtros actuales.</p>
                    <p style="margin-top: 14px;">
                        <a href="@BuildUrl(clearFilters: true, page: 1)" class="btn btn-primary">Limpiar filtros</a>
                    </p>
                }
                else
                {
                    <h2>No hay errores activos</h2>
                    <p>La lista principal esta vacia.</p>
                }
            </section>
        }
        else
        {
            <section class="table-panel" aria-label="Lista de errores">
                <div class="table-toolbar">
                    <p>
                        Página <strong>@Model.CurrentPage</strong> de <strong>@Model.TotalPages</strong>
                        <span aria-hidden="true"> | </span>
                        Tamaño <strong>@Model.PageSize</strong>
                    </p>
                    <p>
                        Mostrando <strong>@Model.FirstRecord-@Model.LastRecord</strong> de <strong>@Model.FilteredRecords</strong>
                        @if (Model.FilteredRecords != Model.TotalRecords)
                        {
                            <span>filtrados de <strong>@Model.TotalRecords</strong> totales</span>
                        }
                    </p>
                </div>

                <div class="table-scroll">
                    <table class="errors-table">
                        <thead>
                            <tr>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.Status)" class="sort-link">
                                        Estatus
                                        <i data-lucide="@SortIcon(ErrorListSortFields.Status)"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.Priority)" class="sort-link">
                                        Prioridad
                                        <i data-lucide="@SortIcon(ErrorListSortFields.Priority)"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.Company)" class="sort-link">
                                        Empresa
                                        <i data-lucide="@SortIcon(ErrorListSortFields.Company)"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.ErrorCode)" class="sort-link">
                                        Código
                                        <i data-lucide="@SortIcon(ErrorListSortFields.ErrorCode)"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.Occurrences)" class="sort-link"> 
                                        Cont 
                                        <i data-lucide="@SortIcon(ErrorListSortFields.Occurrences)"></i> 
                                    </a> 
                                </th> 
                                <th>Programa.Módulo</th>
                                <th>Descripción</th>
                                <th>
                                    <a href="@SortUrl(ErrorListSortFields.LastSeen)" class="sort-link">
                                        Última vez
                                        <i data-lucide="@SortIcon(ErrorListSortFields.LastSeen)"></i>
                                    </a>
                                </th>
                                <th>Acciones Rápidas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var error in Model.Errors)
                            {
                                <tr>
                                    <td data-label="Estatus">
                                        <span class="badge @StatusClass(error.Status)">@StatusLabel(error.Status)</span>
                                    </td>
                                    <td data-label="Prioridad">
                                        <span class="badge @PriorityClass(error.Priority)">@PriorityLabel(error.Priority)</span>
                                    </td>
                                    <td data-label="Empresa">@error.Company</td>
                                    <td data-label="Código">
                                        <a asp-action="Details" asp-route-id="@error.Id" class="code-link">@error.Code</a>
                                    </td>
                                    <td data-label="Cont">
                                        <span class="badge @OccurrenceClass(error.Occurrences)">@error.Occurrences</span>
                                    </td>
                                    <td data-label="Programa.Módulo" class="path-cell">
                                        @error.Program
                                        <span>@error.Module</span>
                                    </td>
                                    <td data-label="Descripción" class="message-cell">@ShortMessage(error.Description)</td>
                                    <td data-label="Última vez">
                                        <span class="date-cell">
                                            <span class="date-relative">@RelativeDate(error.LastSeen)</span>
                                            <span class="date-absolute">@FormatDate(error.LastSeen)</span>
                                        </span>
                                    </td>
                                    <td data-label="Acciones rápidas">
                                        <div class="row-actions">
                                            <a asp-action="Details" asp-route-id="@error.Id" class="btn btn-link">
                                                <i data-lucide="eye"></i>
                                                Detalles
                                            </a>

                                            @await Html.PartialAsync("_ErrorStatusDropdown", new ErrorStatusDropdownViewModel
                                            {
                                                ErrorId = error.Id,
                                                ErrorCode = error.Code,
                                                CurrentStatus = error.Status,
                                                ReturnUrl = returnUrl
                                            })
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <nav class="pager" aria-label="Paginacion">
                    <div class="pager-info">
                        Página @Model.CurrentPage de @Model.TotalPages
                    </div>
                    <div class="pager-actions">
                        @if (Model.HasPreviousPage)
                        {
                            <a href="@BuildUrl(page: Model.CurrentPage - 1)" class="btn btn-secondary">
                                <i data-lucide="chevron-left"></i>
                                Anterior
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-secondary" aria-disabled="true">
                                <i data-lucide="chevron-left"></i>
                                Anterior
                            </span>
                        }

                        @if (Model.HasNextPage)
                        {
                            <a href="@BuildUrl(page: Model.CurrentPage + 1)" class="btn btn-secondary">
                                Siguiente
                                <i data-lucide="chevron-right"></i>
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-secondary" aria-disabled="true">
                                Siguiente
                                <i data-lucide="chevron-right"></i>
                            </span>
                        }
                    </div>
                </nav>
            </section>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/status-dropdown.js" asp-append-version="true"></script>

    <script>
        const loadingState = document.getElementById('loadingState');

        function showLoadingState() {
            if (!loadingState) return;
            loadingState.hidden = false;
        }

        document.getElementById('errorFilters')?.addEventListener('submit', showLoadingState);

        document.querySelectorAll('.sort-link, .pager a').forEach((link) => {
            link.addEventListener('click', showLoadingState);
        });

        if (window.renderLucide) {
            window.renderLucide();
        }
    </script>
}
