@model List<MapcelErrorTracker.Models.ErrorItem>
@using MapcelErrorTracker.Models
@{
    ViewData["Title"] = "Error Logger Dashboard";
    var programs = ViewBag.Programs as List<string> ?? new List<string>();
    int highCount = ViewBag.HighPriorityCount ?? 0;
    string? selProgram = ViewBag.SelectedProgram;
    string? selStatus = ViewBag.SelectedStatus;
    string? selPriority = ViewBag.SelectedPriority;
    string? search = ViewBag.Search;
}

@functions {
    static string PriorityBadge(ErrorPriority p) => p switch
    {
        ErrorPriority.Alta => "bg-red-100 text-red-700 border border-red-300",
        ErrorPriority.Media => "bg-amber-100 text-amber-700 border border-amber-300",
        _ => "bg-gray-100 text-gray-600 border border-gray-300"
    };

    static string StatusBadge(ErrorStatus s) => s switch
    {
        ErrorStatus.New => "bg-green-50 text-green-700 border border-green-300",
        ErrorStatus.InReview => "bg-blue-50 text-blue-700 border border-blue-300",
        ErrorStatus.Postponed => "bg-amber-50 text-amber-700 border border-amber-300",
        ErrorStatus.Resolved => "bg-gray-50 text-gray-500 border border-gray-300",
        _ => "bg-gray-100 text-gray-600 border border-gray-300"
    };

    static string StatusLabel(ErrorStatus s) => s switch
    {
        ErrorStatus.New => "New",
        ErrorStatus.InReview => "In Review",
        ErrorStatus.Postponed => "Postponed",
        ErrorStatus.Resolved => "Resolved",
        _ => s.ToString()
    };

    static string RelativeTime(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 60)
        {
            var m = (int)diff.TotalMinutes;
            return $"hace alrededor de {m} {(m == 1 ? "minuto" : "minutos")}";
        }
        if (diff.TotalHours < 24)
        {
            var h = (int)diff.TotalHours;
            return $"hace alrededor de {h} {(h == 1 ? "hora" : "horas")}";
        }
        if (diff.TotalDays < 2) return "Hace 1 día";
        return $"hace {(int)diff.TotalDays} días";
    }
}

<div class="max-w-7xl mx-auto px-6 py-8">

    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-3">
            <div class="bg-emerald-600 text-white rounded-lg p-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                </svg>
            </div>
            <div>
                <h1 class="text-xl font-bold text-gray-900">Error Logger Dashboard</h1>
            </div>
        </div>
        @if (highCount > 0)
        {
            <span class="flex items-center gap-1.5 bg-red-50 text-red-600 border border-red-200 rounded-full px-3 py-1 text-sm font-medium">
                <span class="w-2 h-2 bg-red-500 rounded-full inline-block"></span>
                @highCount alta prioridad
            </span>
        }
    </div>

    <!-- Filters -->
    <div class="bg-white border border-gray-200 rounded-xl p-4 mb-6 shadow-sm">
        <form method="get" asp-action="Index" class="flex flex-wrap gap-3 items-center">
            <!-- Search -->
            <div class="relative flex-1 min-w-[220px]">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z"/>
                </svg>
                <input type="text" name="search" value="@search" placeholder="Buscar errores..."
                       class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent"/>
            </div>

            <!-- Program -->
            <select name="program" class="text-sm border border-gray-200 rounded-lg px-3 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-400 min-w-[160px]">
                <option value="">Todos los programas</option>
                @foreach (var program in programs)
                {
                    <option value="@program" selected="@(selProgram == program ? "selected" : null)">@program</option>
                }
            </select>

            <!-- Status -->
            <select name="status" class="text-sm border border-gray-200 rounded-lg px-3 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-400 min-w-[140px]">
                <option value="">Todos los estatus</option>
                @foreach (var status in Enum.GetValues<ErrorStatus>())
                {
                    <option value="@status" selected="@(selStatus == status.ToString() ? "selected" : null)">@StatusLabel(status)</option>
                }
            </select>

            <!-- Priority -->
            <select name="priority" class="text-sm border border-gray-200 rounded-lg px-3 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-400 min-w-[140px]">
                <option value="">Todas las prioridades</option>
                @foreach (var priority in Enum.GetValues<ErrorPriority>())
                {
                    <option value="@priority" selected="@(selPriority == priority.ToString() ? "selected" : null)">@priority</option>
                }
            </select>

            <button type="submit" class="bg-emerald-600 text-white text-sm px-4 py-2 rounded-lg hover:bg-emerald-700 transition-colors">
                Aplicar filtro
            </button>
            @if (!string.IsNullOrEmpty(selProgram) || !string.IsNullOrEmpty(selStatus) || !string.IsNullOrEmpty(selPriority) || !string.IsNullOrEmpty(search))
            {
                <a asp-action="Index" class="text-sm text-gray-500 hover:text-gray-700 px-2 py-2 underline">Borrar filtros</a>
            }
        </form>
    </div>

    <!-- Error count -->
    <p class="text-sm text-gray-500 mb-3">@Model.Count error@(Model.Count == 1 ? "" : "es")</p>

    <!-- Table -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <table class="w-full text-sm">
            <thead>
            <tr class="border-b border-gray-200 bg-gray-50">
                <th class="text-left px-5 py-3 font-semibold text-gray-600">Prioridad</th>
                <th class="text-left px-5 py-3 font-semibold text-gray-600">Código</th>
                <th class="text-left px-5 py-3 font-semibold text-gray-600">Programa</th>
                <th class="text-left px-5 py-3 font-semibold text-gray-600">Última ocurrencia ↑↓</th>
                <th class="text-right px-5 py-3 font-semibold text-gray-600">Conteo ↑↓</th>
                <th class="text-left px-5 py-3 font-semibold text-gray-600">Estatus ↑↓</th>
                <th class="px-5 py-3"></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center py-12 text-gray-400">No se encontraron resultados con esos filtros.</td>
                </tr>
            }
            @foreach (var error in Model)
            {
                <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                    <td class="px-5 py-3.5">
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @PriorityBadge(error.Priority)">
                            @error.Priority
                        </span>
                    </td>
                    <td class="px-5 py-3.5">
                        <a asp-action="Details" asp-route-id="@error.Id"
                           class="font-mono text-teal-600 hover:text-teal-800 hover:underline font-medium">
                            @error.Code
                        </a>
                    </td>
                    <td class="px-5 py-3.5 text-gray-700">@error.Program</td>
                    <td class="px-5 py-3.5 text-gray-500">@RelativeTime(error.LastSeen)</td>
                    <td class="px-5 py-3.5 text-right font-semibold text-gray-800">@error.Occurrences</td>
                    <td class="px-5 py-3.5">
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium @StatusBadge(error.Status)">
                            @StatusLabel(error.Status)
                        </span>
                    </td>
                    <td class="px-5 py-3.5 text-right">
                        <a asp-action="Details" asp-route-id="@error.Id"
                           class="text-gray-400 hover:text-gray-700 transition-colors">
                            <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
